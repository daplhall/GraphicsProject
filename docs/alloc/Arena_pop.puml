@startuml Arena_pop
actor John
participant Arena
participant Block

activate Arena
activate Block

John -> Arena: Arena_pop
Arena -> Block
alt #lightblue if pop less or equal to index
    Block -> Block: Reduce index by pop
    Block --> Arena
else #pink
    Block -> Block: Go to previous block
    Block -> Block: Reduce index by renaming pop
    Block --> Arena
end
Arena -> John : returns Success code

@enduml