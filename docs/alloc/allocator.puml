@startuml Allocator
    top to bottom direction

    interface "Dynamiclly allocated ADT" as ADT{
        This needs to be on a Allocator by allocator basis
        + ADT(..., arena)
    }
    
    Interface Arena{
        Arena allocator - Collective Lifetime
        Staticlly linked interface
    }
    
    Interface PoolArena{
        A sub arena which implmenets a pool allocator
        for the region defined
        Staticlly linked interface
        if a problems this behavior it uses it like its own personal arena
        + PoolArena(Arena)
    }

    Interface SubArena{
        Used to define a sub section of an arena, 
        that is normal own arena
        Staticlly linked interface
        + SubArena(Arena)
    }
    class StackArena {
    }
    class FreeListArena{
        
    }
    ADT --> Arena
    ADT --> PoolArena : Depends on need
    ADT --> SubArena : Depends on need
    PoolArena --> Arena
    SubArena --> Arena
    StackArena ..|> Arena
    FreeListArena ..|> Arena
    Arena --> MALLOC
@enduml