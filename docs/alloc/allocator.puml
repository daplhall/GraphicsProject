@startuml Allocator
    top to bottom direction

    interface Allocator{
        When passes to a ADT then all of that ABT will beallocated with the given allocator
        + malloc(capacity)        
        + calloc(n, size)
        + realloc(ptr, capacity);  
        + free(capacity)        
    }
    interface ADT{
        + ADT(..., Allocator)
        - Allocator: If in need of furture allocation (Implemnation detail)
    }
    
    class Arena{
        Arena allocator - Collective Lifetime
    }
    class Bedrock{
        The allocator - Individual Lifetime
    }
    class Atom {
        The Atom allocator - Eternal Lifetime
    }

    
    ADT --> Allocator
    Arena .up.|> Allocator
    Bedrock .up.|> Allocator : Bedcrock_allocator()
    Atom .up.|> Allocator
    Arena --> Bedrock
    Atom --> Bedrock
    
@enduml